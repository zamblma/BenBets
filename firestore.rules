rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras da Coleção de Usuários (/users/{userId})
    // -------------------------------------------------------------------------
    // LEITURA: Qualquer usuário autenticado pode ler a coleção de usuários.
    // Isso é essencial para que o Ranking exiba todos os jogadores cadastrados
    // (com seus saldos, cartas e vitórias) e para a lista de usuários no Painel Admin.
    //
    // ESCRITA: Cada usuário autenticado só pode modificar o seu próprio documento.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
