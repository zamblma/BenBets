rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras da Coleção de Usuários (/users/{userId})
    // -------------------------------------------------------------------------
    // LEITURA E ESCRITA (Ranking + Painel Admin):
    // Permite que usuários autenticados leiam todos os perfis (para o Ranking e Admin)
    // e que o Painel Admin consiga ajustar saldos e reparar contas diretamente no Firestore.
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
